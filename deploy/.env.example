# Names only. Copy to /opt/adfarming/.env ON THE VM and type the values there yourself (chmod 600).
# Never commit the filled file, never paste it into chat.
# Quote the Caddy hash with SINGLE quotes so the $ signs stay literal:  CADDY_BASIC_AUTH_HASH='$2a$14$...'

# --- Meta / Baseten model access (the paid APIs)
META_MODEL_API_KEY=
BASETEN_API_KEY=
BASETEN_MODEL=

# --- Studio app
STUDIO_PASSWORD=            # app login password (rotate_judge.sh keeps it equal to the judge password)
STUDIO_SECRET=              # random 64+ hex chars; signs session cookies. openssl rand -hex 32
STUDIO_RUNNER=real          # real | stub (stub = scripted fake, spends nothing)
STUDIO_AGENT=wonder         # wonder (default) | scripted | deterministic (alias of scripted)
STUDIO_RUN_CAP_USD=1.5      # hard spend cap per run
STUDIO_DAILY_CAP_USD=15     # hard spend cap per day
STUDIO_CLIENT_ID=           # only for the legacy flat layout (no private/clients/ dir); clients/*/client.json are auto-discovered
STUDIO_CLIENT_NAME=         # its display name (optional)
STUDIO_MEMORY_SEED=         # path INSIDE the container to a memory seed dir, e.g. /data/private/memory_seed (optional)
# STUDIO_COOKIE_SECURE=1    # leave unset: auto-detected from X-Forwarded-Proto

# --- Caddy / HTTPS gate
SITE_ADDRESS=               # e.g. 203-0-113-10.sslip.io  (IP with dashes) or your own domain
CADDY_BASIC_AUTH_USER=judge
CADDY_BASIC_AUTH_HASH=      # single-quoted bcrypt hash from rotate_judge.sh or: caddy hash-password

# --- Optional
# PRIVATE_MODE=rw           # rw (default) | ro, how /data/private is mounted
# TAG=latest                # set by deploy.sh
